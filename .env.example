# LiveKit Cloud project (or self-hosted livekit-server)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM (preferred: Claude Sonnet for the Orchestrator, Haiku for experts)
ANTHROPIC_API_KEY=

# STT (preferred)
DEEPGRAM_API_KEY=

# TTS (preferred)
CARTESIA_API_KEY=

# Fallback provider — if ANTHROPIC_API_KEY/DEEPGRAM_API_KEY/CARTESIA_API_KEY
# are left blank, agent/main.py and agent/experts.py fall back to OpenAI
# (gpt-4o-transcribe / gpt-4o-mini / "alloy" TTS voice) so the demo still
# runs end-to-end with just this one key.
OPENAI_API_KEY=

# Where agent/main.py finds the MCP server (mcp_server/server.py --http)
MCP_SERVER_URL=http://localhost:8089/mcp

# Optional: enables device.web_search_troubleshooting; without it the tool
# just reports no results found and the orchestrator offers a human transfer.
TAVILY_API_KEY=
